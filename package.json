{
  "name": "sql-jev",
  "version": "0.1.0",
  "description": "Ask your SQLite tables questions in plain language. SQL-lite port of pg-jev for Turso/libSQL and Cloudflare D1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./schema": "./sql/sql-jev.sql",
    "./package.json": "./package.json"
  },
  "bin": {
    "sql-jev": "./dist/cli.js"
  },
  "files": [
    "dist",
    "sql",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "mock": "bun run mock/mock-api.ts",
    "init": "bun run src/cli.ts init",
    "deploy:turso": "bun run src/cli.ts deploy turso",
    "deploy:d1": "bun run src/cli.ts deploy d1",
    "deploy:d1:worker": "bun run src/cli.ts deploy d1 --worker",
    "typecheck:all": "tsc -p tsconfig.json --noEmit && tsc --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --skipLibCheck templates/d1/worker.ts && bash -n templates/turso/deploy.sh"
  },
  "keywords": [
    "sqlite",
    "libsql",
    "turso",
    "d1",
    "cloudflare",
    "jev",
    "typesafe",
    "natural-language",
    "semantic-filter"
  ],
  "peerDependencies": {
    "@libsql/client": ">=0.18.0"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
