# EditorConfig: https://editorconfig.org
# Two-space indentation matches the TypeScript, SQL and template files in this repository.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sql,sh}]
indent_size = 2
